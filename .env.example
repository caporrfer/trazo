# Hash scrypt de la contraseña del panel. Genéralo con:
#   node scripts/hash-password.mjs 'tu contraseña'
ADMIN_PASSWORD_HASH=

# Secreto aleatorio (mínimo 32 caracteres) para firmar la cookie de sesión:
#   openssl rand -base64 48
AUTH_SESSION_SECRET=

# Ruta del fichero SQLite (en Docker: /data/trazo.sqlite)
TRAZO_DB_PATH=./data/trazo.sqlite

# Base64 de 32 bytes (openssl rand -base64 32). Mantiene válidas las server actions entre despliegues.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Datos legales que aparecen en /privacidad y /aviso-legal
TRAZO_LEGAL_NAME=
TRAZO_TAX_ID=
TRAZO_ADDRESS=
TRAZO_PRIVACY_EMAIL=
