# PostgreSQL local del servidor
DATABASE_URL=postgres://trazo:change-me@db:5432/trazo

# OAuth de Google (las credenciales no se exponen al navegador)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Única cuenta de Google autorizada en el dashboard
ADMIN_EMAIL=

# Origen canónico por entorno, sin barra final. En producción: https://formulariotrazo.es
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo para pruebas locales; debe estar desactivado en producción
TRAZO_DEMO_MODE=true

# Directorio persistente para facturas y adjuntos
TRAZO_STORAGE_DIR=./data/invoices

# Secreto aleatorio usado para anonimizar el origen de red del rate limit
RATE_LIMIT_SECRET=

# Base64 de 32 bytes (por ejemplo: openssl rand -base64 32). Debe ser el mismo en todas las réplicas Docker.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Datos legales que deben completarse antes de producción
TRAZO_LEGAL_NAME=
TRAZO_TAX_ID=
TRAZO_ADDRESS=
TRAZO_PRIVACY_EMAIL=
