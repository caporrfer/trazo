# Supabase gestionado (local, pruebas o producción)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Única cuenta de Google autorizada en el dashboard
ADMIN_EMAIL=

# Origen canónico por entorno, sin barra final. En producción: https://formulariotrazo.es
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo para probar localmente el dashboard y la propuesta de ejemplo
TRAZO_DEMO_MODE=true

# Secreto aleatorio usado para anonimizar el origen de red del rate limit
RATE_LIMIT_SECRET=

# Base64 de 32 bytes (por ejemplo: openssl rand -base64 32). Debe ser el mismo en todas las réplicas Docker.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Datos legales que deben completarse antes de producción
TRAZO_LEGAL_NAME=
TRAZO_TAX_ID=
TRAZO_ADDRESS=
TRAZO_PRIVACY_EMAIL=
